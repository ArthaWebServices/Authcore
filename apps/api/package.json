{
  "name": "@authcore/api",
  "version": "1.0.0",
  "description": "AuthCore API server",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch main.ts",
    "build": "tsc",
    "start": "node --import tsx dist/main.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=../../prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=../../prisma/schema.prisma",
    "db:push": "prisma db push --schema=../../prisma/schema.prisma",
    "db:seed": "tsx ../../prisma/seed.ts",
    "db:studio": "prisma studio --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@authcore/core": "workspace:*",
    "@authcore/crypto": "workspace:*",
    "@authcore/database": "workspace:*",
    "@authcore/validators": "workspace:*",
    "@fastify/autoload": "^6.5.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/oauth2": "^7.6.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@node-rs/argon2": "^2.0.0",
    "@node-rs/bcrypt": "^1.9.0",
    "@prisma/client": "^5.10.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/node": "^10.73.0",
    "@simplewebauthn/server": "^10.0.0",
    "bullmq": "^5.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.3.0",
    "jose": "^5.2.0",
    "nodemailer": "^9.1.1",
    "otplib": "^12.0.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "resend": "^6.25.0",
    "tsx": "^4.7.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^1.3.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "prisma": "^5.10.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
